# ============================================================
#  Caddyfile — hostname-routed local dev.
#
#  Each service gets its own name instead of a path prefix:
#
#      https://api.sakajob.home:7443     backend
#      https://n8n.sakajob.home:7443     n8n
#      https://hub.sakajob.home:7443     beszel monitoring
#
#  Why names instead of /api, /n8n, /monitor: an app hosted under a path prefix
#  has to rewrite every absolute URL it emits, and both n8n and beszel are
#  fiddly about it. On its own hostname each app is simply at "/" and none of
#  that applies.
#
#  Ports 7080/7443 rather than 80/443: another stack on this machine binds
#  0.0.0.0:80 and :443. Docker Desktop does not honour per-loopback-IP binds
#  (a `-p 127.0.0.2:443` request still tries to allocate 0.0.0.0:443 and
#  fails), so a distinct port pair is the only option. Caddy listens on the
#  SAME port numbers inside the container as outside, which keeps redirects,
#  certificate SANs, and Host matching all consistent.
#
#  Requires these lines in the hosts file (see infra/README.md):
#      127.0.0.1  api.sakajob.home
#      127.0.0.1  n8n.sakajob.home
#      127.0.0.1  hub.sakajob.home
#
#  For production: replace the .home names with real domains, drop the :7443
#  suffixes and the `tls internal` lines, and map 80/443. Caddy then fetches
#  real Let's Encrypt certificates automatically.
# ============================================================

{
	# Local dev: issue certificates from Caddy's own CA.
	# (Remove this whole block in production.)
	local_certs
}

# Shared response hardening + compression, applied to every site below.
(common) {
	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	encode gzip
}

# --- Backend API ---
# The path convention differs from the localhost fallback below: here the API
# is at the root (https://api.sakajob.home:7443/jobs), because there is no
# prefix to strip.
https://api.sakajob.home:7443 {
	tls internal
	import common
	reverse_proxy backend:8080
}

# --- n8n ---
https://n8n.sakajob.home:7443 {
	tls internal
	import common
	reverse_proxy n8n:5678
}

# --- Beszel monitoring hub ---
https://hub.sakajob.home:7443 {
	tls internal
	import common
	reverse_proxy beszel:8090
}

# --- localhost fallbacks, kept deliberately ---
# The hosts file is a manual, admin-only step, and a machine that hasn't had it
# applied yet would otherwise have no way to reach anything.
#
# The API keeps its /api/* prefix here: it serves JSON and never emits an
# absolute asset path, so a prefix costs it nothing.
https://localhost:7443 {
	tls internal
	import common

	handle_path /api/* {
		reverse_proxy backend:8080
	}

	respond "JobHunter edge OK — API at /api/, n8n on :7444, monitoring on :7445" 200
}

# n8n and beszel get a PORT each rather than a path prefix, because both build
# absolute asset URLs from the site root. Served under /n8n/, n8n's HTML loads
# but every /static/* request lands on the block above and gets the plain-text
# banner instead of JavaScript, so the editor never boots — which looks exactly
# like a broken login. A dedicated port puts each app at "/" with no rewriting,
# and Caddy is still the only thing exposed to the host.
https://localhost:7444 {
	tls internal
	import common
	reverse_proxy n8n:5678
}

https://localhost:7445 {
	tls internal
	import common
	reverse_proxy beszel:8090
}

# --- plain HTTP redirects to HTTPS ---
http://api.sakajob.home:7080, http://n8n.sakajob.home:7080, http://hub.sakajob.home:7080, http://localhost:7080 {
	redir https://{host}:7443{uri} permanent
}
