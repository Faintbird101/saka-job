# ---- Postgres ----
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jobhunter
DATABASE_URL=postgres://jobhunter:change_me@postgres:5432/jobhunter?sslmode=disable

# ---- Backend ----
API_PORT=2623
API_AUTH_TOKEN=change_me_app_token      # Flutter app sends this
N8N_API_KEY=change_me_n8n_key           # n8n -> backend calls

# ---- RapidAPI (ROTATE the one you pasted earlier!) ----
RAPIDAPI_KEY=your_new_key_here
RAPIDAPI_HOST=linkedin-job-search-api.p.rapidapi.com

# ---- Scoring (WF-B) ----
# keyword = deterministic overlap scoring. Free, no API key, instant.
# llm     = ask a model. Better judgement, needs LLM_API_KEY and credits.
#           Claude Pro does NOT include API access - it is billed separately.
SCORING_MODE=keyword

# ---- LLM (only used when SCORING_MODE=llm) ----
# gemini    Google AI Studio. Has a free tier that covers this workload.
#           Key from https://aistudio.google.com/apikey
# anthropic Claude API. Billed separately from a Claude Pro subscription -
#           Pro does NOT include API access.
LLM_PROVIDER=gemini
# Anthropic API key (starts sk-ant-). Leave unset to run without scoring: the
# backend still boots and serves everything else, and only the scoring
# endpoint reports itself unavailable.
LLM_API_KEY=your_llm_key
# Sonnet tier: scoring is a high-volume classification over short, pre-extracted
# inputs, so Opus would cost several times more for a well-bounded judgement.
# claude-sonnet-5 is the current Sonnet; claude-sonnet-4-6 is the previous one.
# IMPORTANT: Gemini's free tier allows only ~20 generateContent requests per DAY
# per model (quota id GenerateRequestsPerDayPerProjectPerModel-FreeTier). That is
# not enough to score a full day's ingest, which is why SCORING_MODE=keyword is
# the default. The quota is PER MODEL, so switching model gives a fresh 20/day.
# gemini:    gemini-3.5-flash-lite | gemini-flash-lite-latest | gemini-3.6-flash
# anthropic: claude-sonnet-5 | claude-haiku-4-5
LLM_MODEL=gemini-3.5-flash-lite

# ---- SMTP (application sending) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Monitoring ----
# No BESZEL_AGENT_KEY is needed when a Beszel agent already runs on this Docker
# daemon (it reports every container, including these). Only add an agent if
# this host is not yet monitored - see infra/README.md.
